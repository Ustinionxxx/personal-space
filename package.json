{
  "name": "personal-site",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "node scripts/prepare.mjs --dev && astro dev",
    "start": "npm run dev",
    "build": "node scripts/build.mjs",
    "build:empty": "node scripts/build.mjs --empty",
    "check": "node scripts/prepare.mjs --dev && astro check",
    "test": "node --test tests/*.test.mjs",
    "preview": "astro preview",
    "content:init": "node scripts/init-content.mjs"
  },
  "dependencies": {
    "astro": "^7.3.5",
    "opencc-js": "^1.4.2",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.35.5",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.147.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "sharp": "$sharp"
  }
}
