---
import { localeFromPath, messages } from '@/lib/i18n';
const t = messages[localeFromPath(Astro.url.pathname)];
---
<button class="text-link text-small" id="play-boot" type="button" aria-haspopup="dialog" hidden>{t.boot} <span aria-hidden="true">⌘</span></button>
<dialog id="boot-dialog" aria-labelledby="boot-title">
  <div class="terminal-bar"><h2 id="boot-title">personal-space / boot</h2><button id="skip-boot" type="button" autofocus>{t.bootClose}</button></div>
  <pre id="boot-log" aria-live="off" data-lines={JSON.stringify(t.bootLines)}></pre>
  <label class="motion-option"><input type="checkbox" id="reduce-motion" /> {t.reduceMotion}</label>
  <p class="terminal-hint">{t.bootHint}</p>
</dialog>
<script>
  const trigger = document.querySelector<HTMLButtonElement>('#play-boot')!;
  const dialog = document.querySelector<HTMLDialogElement>('#boot-dialog')!;
  const close = document.querySelector<HTMLButtonElement>('#skip-boot')!;
  const log = document.querySelector<HTMLPreElement>('#boot-log')!;
  const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const reduce = document.querySelector<HTMLInputElement>('#reduce-motion')!;
  reduce.checked = document.documentElement.hasAttribute('data-reduced-motion');
  reduce.disabled = motion.matches;
  const lines: string[] = JSON.parse(log.dataset.lines!);
  let timers: ReturnType<typeof setTimeout>[] = [];
  let previousOverflow = '';
  function clearTimers() { timers.forEach(clearTimeout); timers = []; }
  trigger.hidden = false;
  trigger.addEventListener('click', () => {
    clearTimers(); log.textContent = ''; previousOverflow = document.body.style.overflow;
    dialog.showModal(); document.body.style.overflow = 'hidden';
    if (reduce.checked) { log.textContent = lines.join('\n'); return; }
    lines.forEach((line, index) => timers.push(setTimeout(() => { log.textContent += line + '\n'; }, index * 400)));
  });
  close.addEventListener('click', () => dialog.close());
  dialog.addEventListener('close', () => { clearTimers(); document.body.style.overflow = previousOverflow; trigger.focus(); });
  function updateMotion() {
    document.documentElement.toggleAttribute('data-reduced-motion', reduce.checked);
    if (reduce.checked && dialog.open) { clearTimers(); log.textContent = lines.join('\n'); }
  }
  reduce.addEventListener('change', () => {
    try { localStorage.setItem('reduce-motion', String(reduce.checked)); } catch {}
    updateMotion();
  });
  motion.addEventListener('change', () => {
    reduce.disabled = motion.matches;
    let saved = false;
    try { saved = localStorage.getItem('reduce-motion') === 'true'; } catch {}
    reduce.checked = motion.matches || saved;
    updateMotion();
  });
</script>
<style>
  dialog { width: min(640px, calc(100% - 32px)); margin: auto; border: 1px solid #2c5148; border-radius: 10px; background: #0b1311; color: #bed4c8; padding: 0; max-height: calc(100dvh - 48px); }
  dialog::backdrop { background: rgb(0 0 0 / .65); }
  .terminal-bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 16px 20px; border-bottom: 1px solid #2c5148; flex-wrap: wrap; }
  h2, button { font-size: 13px; font-weight: 400; }
  .terminal-bar button { color: #b6e5d1; padding: 8px; }
  pre { min-height: 260px; padding: 24px; white-space: pre-wrap; overflow-wrap: anywhere; font-size: 14px; line-height: 2; }
  .terminal-hint { padding: 0 24px 24px; font-size: 12px; color: #9bb8aa; }
  .motion-option { display: flex; align-items: center; gap: 8px; margin: 0 24px 16px; font-size: 13px; }
</style>
