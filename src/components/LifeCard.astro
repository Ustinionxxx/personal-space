---
import type { LifeRecord } from '@/lib/content';
import { localeFromPath, localizedPath, formatDate, messages } from '@/lib/i18n';
import TranslationNote from './TranslationNote.astro';
interface Props { record: LifeRecord }
const { record } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const t = messages[locale];
const dateLabel = formatDate(record.date, locale);
const href = localizedPath(`/life/${record.slug}`, locale);
---
<article class="life-card" aria-label={record.title || dateLabel + t.record}>
  <a href={href} class="record-date"><time datetime={record.date}>{dateLabel}</time><span aria-hidden="true"> ↗</span></a>
  {record.title && <h3 class="text-h3" lang={record.titleLang}><a href={href}>{record.title}</a></h3>}
  <TranslationNote show={record.translationFallback} />
  {record.html && <div class="prose record-body" lang={record.bodyLang} set:html={record.html} />}
  {record.images.length > 0 && <div class:list={['record-photos', { 'record-photos--multiple': record.images.length > 1 }]}>
    {record.images.slice(0, 3).map((photo, index) => <a href={href} aria-label={`${t.viewPhoto} ${index + 1} · ${dateLabel}`}>
      <img src={photo.src} width={photo.width} height={photo.height} lang={photo.alt ? photo.altLang : photo.caption ? photo.captionLang : undefined} alt={photo.alt || photo.caption || `${t.photo} ${index + 1}`} loading="lazy" decoding="async" />
    </a>)}
  </div>}
  {record.images.length > 3 && <a class="text-link text-small" href={href}>{t.allPhotos} ({record.images.length})</a>}
  {record.tags.length > 0 && <ul class="tag-list" aria-label={t.tags}>{record.tags.map(tag => <li>#{tag}</li>)}</ul>}
</article>
<style>
  .life-card { padding: 28px 0 32px; border-top: 1px solid var(--border); min-width: 0; }
  .record-date { display: inline-block; color: var(--text-secondary); font-size: var(--text-caption); margin-bottom: 12px; padding: 4px 0; }
  .record-date:hover, h3 a:hover { color: var(--accent); }
  h3 { margin-bottom: 12px; overflow-wrap: anywhere; }
  .record-photos { display: grid; gap: 12px; margin-top: 20px; align-items: start; }
  .record-photos a { min-width: 0; }
  .record-photos img { width: 100%; height: auto; border-radius: 6px; }
  .record-photos--multiple { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .record-photos--multiple:has(a:nth-child(2):last-child) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (max-width: 600px) { .record-photos--multiple, .record-photos--multiple:has(a:nth-child(2):last-child) { grid-template-columns: 1fr; } }
</style>
