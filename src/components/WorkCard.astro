---
import type { Project } from '@/lib/content';
import { localeFromPath, localizedPath, messages } from '@/lib/i18n';
import TranslationNote from './TranslationNote.astro';
interface Props { project: Project }
const { project } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const t = messages[locale];
const href = localizedPath(`/work/${project.slug}`, locale);
---
<article class:list={['work-card', { 'work-card--image': !!project.cover }]}>
  {project.cover && <a href={href} tabindex="-1" aria-hidden="true"><img src={project.cover.src} width={project.cover.width} height={project.cover.height} alt="" loading="lazy" decoding="async" /></a>}
  <div>
    <p class="project-stage">{t.stages[project.stage]}</p>
    <h3 class="text-h3" lang={project.titleLang}><a href={href}>{project.title} <span aria-hidden="true">↗</span></a></h3>
    <TranslationNote show={project.translationFallback} />
    {project.description && <p class="project-description" lang={project.descriptionLang}>{project.description}</p>}
    {project.tech.length > 0 && <ul class="tag-list" aria-label={t.tech}>{project.tech.map(tag => <li>{tag}</li>)}</ul>}
  </div>
</article>
<style>
  .work-card { border-top: 1px solid var(--border); padding: 28px 0; min-width: 0; }
  .work-card--image { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr); gap: 24px; align-items: center; }
  img { border-radius: 6px; width: 100%; height: auto; }
  .project-stage { color: var(--accent); font-size: var(--text-caption); margin-bottom: 8px; }
  h3 { overflow-wrap: anywhere; }
  h3 a:hover { color: var(--accent); }
  h3 span { font-size: 16px; color: var(--accent); }
  .project-description { color: var(--text-secondary); margin-top: 12px; }
  @media (max-width: 600px) { .work-card--image { grid-template-columns: 1fr; } }
</style>
