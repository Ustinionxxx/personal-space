---
import "@/styles/global.css";
import { localeFromPath, localizedPath, locales, languageTags, messages } from '@/lib/i18n';
import { getContent } from '@/lib/content';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const home = getContent(locale).home;
// Pages without their own summary fall back to the homepage intro for search results and share cards.
const pageDescription = description || home.intro || messages[locale].space;
const pageUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const shareImage = Astro.site ? new URL('/og-image.png', Astro.site).href : undefined;
const ogLocales: Record<typeof locale, string> = { 'zh-cn': 'zh_CN', 'zh-tw': 'zh_TW', en: 'en_US' };
---

<!doctype html>
<html lang={languageTags[locale]} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={pageDescription} />
    {noindex && <meta name="robots" content="noindex" />}
    {pageUrl && <link rel="canonical" href={pageUrl} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#2E6F6A" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={home.name} />
    <meta property="og:locale" content={ogLocales[locale]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={pageDescription} />
    {pageUrl && <meta property="og:url" content={pageUrl} />}
    {shareImage && <meta property="og:image" content={shareImage} />}
    {shareImage && <meta property="og:image:width" content="1200" />}
    {shareImage && <meta property="og:image:height" content="630" />}
    {shareImage && <meta property="og:image:alt" content={`${home.name} · ${messages[locale].space}`} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={pageDescription} />
    {shareImage && <meta name="twitter:image" content={shareImage} />}
    {Astro.site && !noindex && <link rel="sitemap" href="/sitemap-index.xml" />}
    {Astro.site && !noindex && locales.map(language => <link rel="alternate" hreflang={languageTags[language]} href={new URL(localizedPath(Astro.url.pathname, language), Astro.site)} />)}
    {Astro.site && !noindex && <link rel="alternate" hreflang="x-default" href={new URL(localizedPath(Astro.url.pathname, 'zh-cn'), Astro.site)} />}
  </head>
  <body>
    <script is:inline>
      // Apply saved theme before paint to prevent flash
      (function () {
        let saved;
        try { saved = localStorage.getItem("theme"); } catch {}
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)"
        ).matches;
        const theme = ['light', 'dark'].includes(saved) ? saved : (prefersDark ? "dark" : "light");
        document.documentElement.setAttribute("data-theme", theme);
        let reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        try { reduceMotion ||= localStorage.getItem('reduce-motion') === 'true'; } catch {}
        document.documentElement.toggleAttribute('data-reduced-motion', reduceMotion);
      })();
    </script>
    <a class="skip-link" href="#main-content">{messages[locale].skip}</a>
    <slot />
  </body>
</html>
