---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import Character from '@/components/Character.astro';
import { content } from '@/lib/content';
---
<BaseLayout title={`关于 · ${content.home.name}`}>
  <Nav />
  <main id="main-content" class="container container-narrow page-content">
    <header class="page-heading"><Character id="hero" size={48} /><h1 class="text-h1">关于我</h1></header>
    {content.about.html ? <div class="prose" set:html={content.about.html} /> : <p class="text-secondary">这部分还在整理。</p>}
    <div class="link-row related">
      {content.home.github && <a class="text-link" href={content.home.github}>GitHub ↗</a>}
      {content.home.email && <a class="text-link" href={`mailto:${content.home.email}`}>写封邮件</a>}
    </div>
  </main>
  <Footer />
</BaseLayout>
