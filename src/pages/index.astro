---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import Character from '@/components/Character.astro';
import LifeCard from '@/components/LifeCard.astro';
import WorkCard from '@/components/WorkCard.astro';
import BootSplash from '@/components/BootSplash.astro';
import { content } from '@/lib/content';
const { home, life, work } = content;
const selected = work.find(p => p.id === home.featuredWork);
---
<BaseLayout title={home.name} description={home.intro}>
  <Nav />
  <main id="main-content" class="container home">
    <header class="home-hero">
      <div class="home-character"><Character id="hero" size={78} animate /></div>
      <p class="eyebrow">一个个人空间</p>
      <h1 class="text-display">{home.name}</h1>
      {home.intro && <p class="home-intro">{home.intro}</p>}
      {home.now && <p class="home-now"><span aria-hidden="true">●</span> 最近在{home.now}</p>}
    </header>
    <section class="home-section" aria-labelledby="recent-heading">
      <div class="section-heading"><h2 id="recent-heading" class="text-h2">最近留下的</h2><a class="text-link text-small" href="/life">去生活里看看 <span aria-hidden="true">↗</span></a></div>
      {life.length ? life.slice(0, 3).map(record => <LifeCard record={record} />) : <p class="quiet-empty">还没有公开的记录。这里先留一点空白。</p>}
    </section>
    {selected && <section class="home-section" aria-labelledby="work-heading">
      <div class="section-heading"><h2 id="work-heading" class="text-h2">最近的折腾</h2><a class="text-link text-small" href="/work">更多折腾 <span aria-hidden="true">↗</span></a></div>
      <WorkCard project={selected} />
    </section>}
    <section class="home-contact" aria-label="关于与联系">
      <a class="text-link" href="/about">再认识我一点 <span aria-hidden="true">↗</span></a>
      <div class="link-row">
        {home.github && <a class="text-link text-small" href={home.github}>GitHub <span aria-hidden="true">↗</span></a>}
        {home.email && <a class="text-link text-small" href={`mailto:${home.email}`}>写封邮件</a>}
        <BootSplash />
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
<style>
  .home { max-width: 860px; }
  .home-hero { padding: 90px 0 100px; position: relative; max-width: 660px; }
  .home-character { float: right; margin: 12px 4px 24px 24px; color: var(--accent); }
  .eyebrow { color: var(--text-secondary); font-size: var(--text-small); margin-bottom: 20px; }
  h1 { letter-spacing: .04em; }
  .home-intro { color: var(--text-secondary); font-size: 18px; margin-top: 24px; max-width: 550px; white-space: pre-line; }
  .home-now { margin-top: 24px; font-size: var(--text-small); color: var(--text-secondary); }
  .home-now span { color: var(--accent); font-size: 8px; margin-right: 8px; }
  .home-section { margin-bottom: 64px; }
  .home-contact { border-top: 1px solid var(--border); padding: 32px 0 0; display: flex; flex-wrap: wrap; align-items: center; gap: 24px; justify-content: space-between; }
  @media (max-width: 600px) {
    .home-hero { padding: 60px 0 64px; }
    .home-intro { font-size: 16px; }
    .home-character { transform: scale(.85); transform-origin: right top; margin-left: 8px; }
    .home-section { margin-bottom: 48px; }
  }
</style>
