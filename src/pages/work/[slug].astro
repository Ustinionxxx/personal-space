---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import { content, stageLabels, type Project } from '@/lib/content';
export function getStaticPaths() { return content.work.map(project => ({ params: { slug: project.slug }, props: { project } })); }
interface Props { project: Project }
const { project } = Astro.props;
---
<BaseLayout title={`${project.title} · ${content.home.name}`} description={project.description}>
  <Nav />
  <main id="main-content" class="container container-narrow page-content">
    <a class="back-link" href="/work">← 折腾</a>
    <article>
      <header class="page-heading"><p class="text-accent text-small">{stageLabels[project.stage]}</p><h1 class="text-h1">{project.title}</h1>{project.description && <p>{project.description}</p>}</header>
      {project.cover && <div class="photo-story"><img src={project.cover.src} width={project.cover.width} height={project.cover.height} alt="项目画面" /></div>}
      <div class="prose" set:html={project.html} />
      {project.tech.length > 0 && <ul class="tag-list" aria-label="技术">{project.tech.map(tag => <li>{tag}</li>)}</ul>}
      <div class="link-row related">
        {project.links?.github && <a class="text-link" href={project.links.github}>源码 ↗</a>}
        {project.links?.demo && <a class="text-link" href={project.links.demo}>在线演示 ↗</a>}
        {project.links?.process && <a class="text-link" href={project.links.process}>过程记录 ↗</a>}
        {project.lifeRef && <a class="text-link" href={`/life/${project.lifeRef}`}>相关生活记录 ↗</a>}
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>
