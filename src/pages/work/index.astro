---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import WorkCard from '@/components/WorkCard.astro';
import EmptyState from '@/components/EmptyState.astro';
import { content } from '@/lib/content';
---
<BaseLayout title={`折腾 · ${content.home.name}`}>
  <Nav />
  <main id="main-content" class="container container-narrow page-content">
    <header class="page-heading"><h1 class="text-h1">折腾</h1><p>做过的、还在做的，也有暂时放下的。</p></header>
    {content.work.length ? content.work.map(project => <WorkCard project={project} />) : <EmptyState character="coder" message="项目还在整理，先留个位置。" />}
  </main>
  <Footer />
</BaseLayout>
