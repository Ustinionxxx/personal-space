---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import Character from '@/components/Character.astro';
import { getContent } from '@/lib/content';
import { localeFromPath, messages } from '@/lib/i18n';
import TranslationNote from '@/components/TranslationNote.astro';
const locale = localeFromPath(Astro.url.pathname);
const t = messages[locale];
const content = getContent(locale);

---
<BaseLayout title={`${t.about} · ${content.home.name}`}>
  <Nav />
  <main id="main-content" class="container container-narrow page-content">
    <header class="page-heading"><Character id="hero" size={48} /><h1 class="text-h1">{t.aboutMe}</h1></header>
    <TranslationNote show={content.about.translationFallback} />
    {content.about.html ? <div class="prose" lang={content.about.bodyLang} set:html={content.about.html} /> : <p class="text-secondary">{t.aboutEmpty}</p>}
    <div class="link-row related">
      {content.home.github && <a class="text-link" href={content.home.github}>GitHub ↗</a>}
      {content.home.email && <a class="text-link" href={`mailto:${content.home.email}`}>{t.email}</a>}
    </div>
  </main>
  <Footer />
</BaseLayout>
