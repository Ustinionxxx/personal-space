---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import type { LifeRecord } from '@/lib/content';
import { getContent } from '@/lib/content';
import { localeFromPath, localizedPath, formatDate, messages } from '@/lib/i18n';
import TranslationNote from '@/components/TranslationNote.astro';
const locale = localeFromPath(Astro.url.pathname);
const t = messages[locale];
const content = getContent(locale);
interface Props { record: LifeRecord }
const { record } = Astro.props;
const title = record.title || formatDate(record.date, locale) + t.record;
---
<BaseLayout title={`${title} · ${content.home.name}`}>
  <Nav />
  <main id="main-content" class="container container-narrow page-content">
    <a class="back-link" href={localizedPath('/life', locale)}>← {t.life}</a>
    <article>
      <header class="page-heading"><time class="text-small text-secondary" datetime={record.date}>{formatDate(record.date, locale)}</time><h1 class:list={['text-h1', { 'sr-only': !record.title }]} lang={record.title ? record.titleLang : undefined}>{title}</h1></header>
      <TranslationNote show={record.translationFallback} />
      {record.html && <div class="prose" lang={record.bodyLang} set:html={record.html} />}
      {record.images.length > 0 && <div class="photo-story">{record.images.map((photo, index) => <figure>
        <img src={photo.src} width={photo.width} height={photo.height} lang={photo.alt ? photo.altLang : photo.caption ? photo.captionLang : undefined} alt={photo.alt || photo.caption || `${t.photo} ${index + 1}`} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
        {photo.caption && <figcaption lang={photo.captionLang}>{photo.caption}</figcaption>}
      </figure>)}</div>}
      {record.tags.length > 0 && <ul class="tag-list" aria-label={t.tags}>{record.tags.map(tag => <li>#{tag}</li>)}</ul>}
      {record.workRef && <p class="related"><a class="text-link" href={localizedPath(`/work/${record.workRef}`, locale)}>{t.relatedWork} ↗</a></p>}
    </article>
  </main>
  <Footer />
</BaseLayout>
